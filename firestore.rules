rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SECURITY PRIMITIVES & IDENTITY CONSTRAINTS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to identify both system owner and developer email with active runtime verification
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@rkfurniture.com' ||
        request.auth.token.email == 'shuvojahedurrahman15@gmail.com'
      );
    }

    // --- SECURED COLLECTIONS ---

    // 1. Products Catalog
    match /products/{productId} {
      allow read: if true; // Publicly guest-readable
      allow write: if isAdmin(); // Strict admin modifications only
    }

    // 2. Navigation Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Carousel Slides
    match /slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Shipping Rates & Areas
    match /shipping_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin(); // Secured admin logistics rates
    }

    // 5. Store Customer Support Contacts
    match /store_contact/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Shop Policies
    match /shop_policies/{policyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Promo Coupon Codes
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Active Web Visitors Heartbeats & Live Sessions
    match /sessions/{sessionId} {
      allow read, write: if true; // Guest browser heartbeats
    }

    // 9. Registered Users Registry
    match /users/{userId} {
      allow read, write: if true; // Self-registration and credentials matching during checkouts
    }

    // 10. Orders Booking & Tracking Logs
    match /orders/{orderId} {
      allow read, write: if true; // Customers checkouts / tracking log, Admin manages
    }
  }
}
