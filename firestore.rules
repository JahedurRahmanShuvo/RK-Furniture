rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL SAFETY NET - DENY BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. REUSABLE SECURITY PRIMITIVES (Phase 3 Primitives)
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'admin@rkfurniture.com' ||
         request.auth.token.email == 'shuvojahedurrahman15@gmail.com')
        && (request.auth.token.email_verified == true || 
            request.auth.token.firebase.sign_in_provider == 'google.com' || 
            request.auth.token.firebase.sign_in_provider == 'password')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. SCHEMA VALIDATION BLUEPRINTS (Pillar 2: Anti-Update-Gaps)
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'image', 'category'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price > 0
        && data.image is string && data.image.size() > 0 && data.image.size() <= 500
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && (!data.keys().contains('oldPrice') || (data.oldPrice is number && data.oldPrice >= 0))
        && (!data.keys().contains('description') || (data.description is string && data.description.size() <= 2000))
        && (!data.keys().contains('specs') || (data.specs is string && data.specs.size() <= 2000))
        && (!data.keys().contains('rating') || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!data.keys().contains('reviews') || (data.reviews is number && data.reviews >= 0))
        && (!data.keys().contains('isTrending') || (data.isTrending is bool))
        && (!data.keys().contains('stock') || (data.stock is number && data.stock >= 0));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!data.keys().contains('image') || (data.image is string && data.image.size() <= 500));
    }

    function isValidSlide(data) {
      return data.keys().hasAll(['id', 'title', 'bg'])
        && data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.bg is string && data.bg.size() > 0 && data.bg.size() <= 500
        && (!data.keys().contains('subtitle') || (data.subtitle is string && data.subtitle.size() <= 500))
        && (!data.keys().contains('position') || (data.position is string && data.position.size() <= 50));
    }

    function isValidShippingArea(data) {
      return data.keys().hasAll(['id', 'name', 'charge'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.charge is number && data.charge >= 0;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && (!data.keys().contains('password') || (data.password is string && data.password.size() <= 100));
    }

    function isValidStoreContact(data) {
      return data.keys().hasAll(['id', 'phone', 'whatsappUrl'])
        && data.id is string && isValidId(data.id)
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 25
        && data.whatsappUrl is string && data.whatsappUrl.size() > 0 && data.whatsappUrl.size() <= 500
        && (!data.keys().contains('hours') || (data.hours is string && data.hours.size() <= 200));
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'code', 'discountPercent', 'isActive'])
        && data.id is string && isValidId(data.id)
        && data.code is string && data.code.size() > 0 && data.code.size() <= 50
        && data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100
        && data.isActive is bool
        && (!data.keys().contains('description') || (data.description is string && data.description.size() <= 500));
    }

    function isValidShopPolicies(data) {
      return data.keys().hasAll(['id', 'aboutUs', 'privacyPolicy', 'termsConditions', 'refundPolicy', 'cancelationPolicy'])
        && data.id is string && isValidId(data.id)
        && data.aboutUs is string && data.aboutUs.size() > 0
        && data.privacyPolicy is string && data.privacyPolicy.size() > 0
        && data.termsConditions is string && data.termsConditions.size() > 0
        && data.refundPolicy is string && data.refundPolicy.size() > 0
        && data.cancelationPolicy is string && data.cancelationPolicy.size() > 0;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['sessionId', 'deviceName', 'isAdmin', 'lastSeen'])
        && data.sessionId is string && isValidId(data.sessionId)
        && data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 200
        && data.isAdmin is bool
        && data.lastSeen is number
        && (!data.keys().contains('phone') || (data.phone is string && data.phone.size() <= 25));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'customerName', 'customerMobile', 'deliveryAddress', 'total', 'status'])
        && data.id is string && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 100
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.customerMobile is string && data.customerMobile.size() > 0 && data.customerMobile.size() <= 25
        && data.deliveryAddress is string && data.deliveryAddress.size() > 0 && data.deliveryAddress.size() <= 500
        && data.total is number && data.total >= 0
        && data.status is string && (data.status == 'Pending' || data.status == 'Processing' || data.status == 'Delivered' || data.status == 'Canceled' || data.status == 'Shipped' || data.status == 'Refunded')
        && (!data.keys().contains('shippingArea') || (data.shippingArea is string && data.shippingArea.size() <= 100))
        && (!data.keys().contains('shippingCharge') || (data.shippingCharge is number && data.shippingCharge >= 0))
        && (!data.keys().contains('paymentMethod') || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!data.keys().contains('subtotal') || (data.subtotal is number && data.subtotal >= 0))
        && (!data.keys().contains('note') || (data.note is string && data.note.size() <= 2000))
        && (!data.keys().contains('createdAt') || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!data.keys().contains('products') || (data.products is list && data.products.size() <= 50));
    }

    // 4. COLLECTION MATCH BLOCKS (Phase 1 Codebase Match Compliance)

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      allow read: if true; // Public access to view catalog
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // --- CATEGORIES COLLECTION ---
    match /categories/{categoryId} {
      allow read: if true; // Public access for navigation
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // --- CAROUSEL SLIDES COLLECTION ---
    match /slides/{slideId} {
      allow read: if true; // Public promo viewing
      allow create: if isAdmin() && isValidId(slideId) && isValidSlide(incoming());
      allow update: if isAdmin() && isValidSlide(incoming());
      allow delete: if isAdmin();
    }

    // --- SHIPPING AREAS COLLECTION ---
    match /shipping_areas/{areaId} {
      allow read: if true; // Public shipping cost computation
      allow create: if isAdmin() && isValidId(areaId) && isValidShippingArea(incoming());
      allow update: if isAdmin() && isValidShippingArea(incoming());
      allow delete: if isAdmin();
    }

    // --- STORE LIVE CONTACT (SUPPORT) COLLECTION ---
    match /store_contact/{contactId} {
      allow read: if true; // Public support info
      allow create: if isAdmin() && isValidId(contactId) && isValidStoreContact(incoming());
      allow update: if isAdmin() && isValidStoreContact(incoming());
      allow delete: if isAdmin();
    }

    // --- SHOP TERMS & LEGAL POLICIES COLLECTION ---
    match /shop_policies/{policyId} {
      allow read: if true; // Public policy pages
      allow create: if isAdmin() && isValidId(policyId) && isValidShopPolicies(incoming());
      allow update: if isAdmin() && isValidShopPolicies(incoming());
      allow delete: if isAdmin();
    }

    // --- COUPONS COLLECTION (PROMOS) ---
    match /coupons/{couponId} {
      allow read: if true; // Public discount validation
      allow create: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming());
      allow update: if isAdmin() && isValidCoupon(incoming());
      allow delete: if isAdmin();
    }

    // --- REALTIME ACTIVE SESSIONS ---
    match /sessions/{sessionId} {
      allow read: if true; // Allow active heartbeats to keep visitors synced
      allow create: if isValidId(sessionId) && isValidSession(incoming());
      allow update: if isValidId(sessionId) && isValidSession(incoming()) && (
        isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['lastSeen'])
      );
      allow delete: if isAdmin();
    }

    // --- SYSTEM METADATA ---
    match /system_meta/{metaId} {
      allow read: if true;
      allow write: if isAdmin(); // Strictly secure meta writes
    }

    // --- USERS ACCOUNT REGISTRY ---
    match /users/{phone} {
      allow read: if true; // Public checking of account existence
      allow create: if isValidId(phone) && isValidUser(incoming());
      allow update: if isAdmin() || (isSignedIn() && isValidUser(incoming()));
      allow delete: if isAdmin();
    }

    // --- ORDERS TRACK DECK ---
    match /orders/{orderId} {
      allow read: if true; // Public tracking code validation
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      // Pillar 4 & Pillar 6: Tiered Identity & State protection
      allow update: if isAdmin() || (
        isValidOrder(incoming()) && (
          // Protect terminal state modifications
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly(['note'])
        )
      );
      allow delete: if isAdmin();
    }
  }
}
