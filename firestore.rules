rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@rkfurniture.com' ||
        request.auth.token.email == 'shuvojahedurrahman15@gmail.com'
      );
    }

    // --- EXPLICIT RESOURCE SCHEMAS (Everyone can read, authenticated admins/backend can write) ---

    // 1. Products Catalog
    match /products/{productId} {
      allow read: if true; // Visitors can view products instantly
      allow write: if true; // Seamless updates from admin dashboard and seeding
    }

    // 2. Navigation Categories
    match /categories/{categoryId} {
      allow read: if true; // Navigation and menus load instantly
      allow write: if true; // Create/edit categories
    }

    // 3. Carousel Slides
    match /slides/{slideId} {
      allow read: if true; // Front page sliders load instantly
      allow write: if true; // Manage sliders
    }

    // 4. Shipping Rates & Areas
    match /shipping_areas/{areaId} {
      allow read: if true; // Dynamic checkout shipping calculations
      allow write: if true; // Manage shipping rates
    }

    // 5. Store Customer Support Contacts
    match /store_contact/{contactId} {
      allow read: if true; // Help desk & WhatsApp contact links
      allow write: if true; // Modify support contact detail
    }

    // 6. Shop Policies (About, Refund, Cancellations)
    match /shop_policies/{policyId} {
      allow read: if true; // Policy terms are publicly visible
      allow write: if true; // Edit policies
    }

    // 7. Promo Coupons Codes
    match /coupons/{couponId} {
      allow read: if true; // Public coupon verification
      allow write: if true; // Manage active vouchers
    }

    // 8. Active Web Visitors Heartbeats
    match /sessions/{sessionId} {
      allow read, write: if true; // Enable real-time visitor tracking
    }

    // 9. Users Registry
    match /users/{userId} {
      allow read, write: if true; // Allow client sign up & lookups smoothly
    }

    // 10. Orders
    match /orders/{orderId} {
      allow read, write: if true; // Enable smooth checkout & check order status
    }

    // --- FAIL-SAFE BACKUP RULE ---
    match /{document=**} {
      allow read, write: if true; // Fallback to avoid any unexpected blockage
    }
  }
}
