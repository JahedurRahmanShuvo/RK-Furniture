rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@rkfurniture.com" ||
        request.auth.token.email == "shuvojahedurrahman15@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints for Entities
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'image', 'category']) &&
             data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.image is string && data.image.size() <= 1000 &&
             data.category is string && data.category.size() <= 100 &&
             (!data.keys().hasAny(['oldPrice']) || (data.oldPrice is number)) &&
             (!data.keys().hasAny(['discountPercent']) || (data.discountPercent is number)) &&
             (!data.keys().hasAny(['description']) || (data.description is string)) &&
             (!data.keys().hasAny(['specs']) || (data.specs is string)) &&
             (!data.keys().hasAny(['isTrending']) || (data.isTrending is bool)) &&
             (!data.keys().hasAny(['stock']) || (data.stock is number)) &&
             (!data.keys().hasAny(['images']) || (data.images is list)) &&
             (!data.keys().hasAny(['rating']) || (data.rating is number)) &&
             (!data.keys().hasAny(['reviews']) || (data.reviews is number));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'customerName', 'customerMobile', 'deliveryAddress', 'total', 'status']) &&
             data.id is string && data.id.size() <= 100 &&
             data.orderNumber is string && data.orderNumber.size() <= 100 &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.customerMobile is string && data.customerMobile.size() <= 30 &&
             data.deliveryAddress is string && data.deliveryAddress.size() <= 1000 &&
             data.total is number && data.total >= 0 &&
             data.status is string && data.status.size() <= 50 &&
             (!data.keys().hasAny(['shippingArea']) || (data.shippingArea is string && data.shippingArea.size() <= 100)) &&
             (!data.keys().hasAny(['shippingCharge']) || (data.shippingCharge is number)) &&
             (!data.keys().hasAny(['paymentMethod']) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!data.keys().hasAny(['subtotal']) || (data.subtotal is number)) &&
             (!data.keys().hasAny(['note']) || (data.note is string && data.note.size() <= 1000)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
             (!data.keys().hasAny(['products']) || (data.products is list));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.keys().size() <= 3 &&
             data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             (!data.keys().hasAny(['image']) || (data.image is string && data.image.size() <= 1000));
    }

    function isValidSlide(data) {
      return data.keys().hasAll(['id', 'title', 'bg']) &&
             data.keys().size() <= 5 &&
             data.id is string && data.id.size() <= 100 &&
             data.title is string && data.title.size() <= 200 &&
             data.bg is string && data.bg.size() <= 1000 &&
             (!data.keys().hasAny(['subtitle']) || (data.subtitle is string && data.subtitle.size() <= 500)) &&
             (!data.keys().hasAny(['position']) || (data.position is string && data.position.size() <= 50));
    }

    function isValidShippingArea(data) {
      return data.keys().hasAll(['id', 'name', 'charge']) &&
             data.keys().size() == 3 &&
             data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.charge is number && data.charge >= 0;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email']) &&
             data.keys().size() <= 3 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             (!data.keys().hasAny(['password']) || (data.password is string && data.password.size() <= 100));
    }

    function isValidStoreContact(data) {
      return data.keys().hasAll(['id', 'phone', 'whatsappUrl']) &&
             data.keys().size() <= 4 &&
             data.id is string && data.id.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.whatsappUrl is string && data.whatsappUrl.size() <= 1000 &&
             (!data.keys().hasAny(['hours']) || (data.hours is string && data.hours.size() <= 500));
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'code', 'discountPercent', 'isActive']) &&
             data.keys().size() <= 5 &&
             data.id is string && data.id.size() <= 100 &&
             data.code is string && data.code.size() <= 50 &&
             data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100 &&
             data.isActive is bool &&
             (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 500));
    }

    function isValidShopPolicies(data) {
      return data.keys().hasAll(['id', 'aboutUs', 'privacyPolicy', 'termsConditions', 'refundPolicy', 'cancelationPolicy']) &&
             data.keys().size() == 6 &&
             data.id is string && data.id.size() <= 100 &&
             data.aboutUs is string && data.aboutUs.size() <= 10000 &&
             data.privacyPolicy is string && data.privacyPolicy.size() <= 10000 &&
             data.termsConditions is string && data.termsConditions.size() <= 10000 &&
             data.refundPolicy is string && data.refundPolicy.size() <= 10000 &&
             data.cancelationPolicy is string && data.cancelationPolicy.size() <= 10000;
    }

    // 4. Collection Rule Declarations

    // Seeding metadata tracking (system)
    match /system_meta/{metaId} {
      allow read, write: if true;
    }

    // Products Matching Room - Publicly readable, write only by Admin or system initialization
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming()) && (isAdmin() || !isSignedIn());
      allow update: if isValidId(productId) && isValidProduct(incoming()) && (isAdmin() || !isSignedIn());
      allow delete: if isValidId(productId) && (isAdmin() || !isSignedIn());
    }

    // Categories Matching Room - Publicly readable, write only by Admin or system initialization
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isValidId(categoryId) && isValidCategory(incoming()) && (isAdmin() || !isSignedIn());
      allow update: if isValidId(categoryId) && isValidCategory(incoming()) && (isAdmin() || !isSignedIn());
      allow delete: if isValidId(categoryId) && (isAdmin() || !isSignedIn());
    }

    // Slides Matching Room - Publicly readable, write only by Admin or system initialization
    match /slides/{slideId} {
      allow read: if true;
      allow create: if isValidId(slideId) && isValidSlide(incoming()) && (isAdmin() || !isSignedIn());
      allow update: if isValidId(slideId) && isValidSlide(incoming()) && (isAdmin() || !isSignedIn());
      allow delete: if isValidId(slideId) && (isAdmin() || !isSignedIn());
    }

    // Shipping areas - Publicly readable, write only by Admin or system initialization
    match /shipping_areas/{areaId} {
      allow read: if true;
      allow create: if isValidId(areaId) && isValidShippingArea(incoming()) && (isAdmin() || !isSignedIn());
      allow update: if isValidId(areaId) && isValidShippingArea(incoming()) && (isAdmin() || !isSignedIn());
      allow delete: if isValidId(areaId) && (isAdmin() || !isSignedIn());
    }

    // Store Contact properties Help Desk - Publicly readable, write only by Admin or system initialization
    match /store_contact/{contactId} {
      allow read: if true;
      allow create: if isValidId(contactId) && isValidStoreContact(incoming()) && (isAdmin() || !isSignedIn());
      allow update: if isValidId(contactId) && isValidStoreContact(incoming()) && (isAdmin() || !isSignedIn());
      allow delete: if isValidId(contactId) && (isAdmin() || !isSignedIn());
    }

    // Dynamic Promo Discount Coupons - Publicly readable, write only by Admin or system initialization
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isValidId(couponId) && isValidCoupon(incoming()) && (isAdmin() || !isSignedIn());
      allow update: if isValidId(couponId) && isValidCoupon(incoming()) && (isAdmin() || !isSignedIn());
      allow delete: if isValidId(couponId) && (isAdmin() || !isSignedIn());
    }

    // Shop Policies - Publicly readable, write only by Admin or system initialization
    match /shop_policies/{policyId} {
      allow read: if true;
      allow create: if isValidId(policyId) && isValidShopPolicies(incoming()) && (isAdmin() || !isSignedIn());
      allow update: if isValidId(policyId) && isValidShopPolicies(incoming()) && (isAdmin() || !isSignedIn());
      allow delete: if isValidId(policyId) && (isAdmin() || !isSignedIn());
    }

    // Orders Placed Database - Anyone can read/place order, update fields
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && (isAdmin() || !isSignedIn() || isSignedIn());
      allow update: if isValidId(orderId) && isValidOrder(incoming()) && (isAdmin() || !isSignedIn() || isSignedIn());
      allow delete: if isValidId(orderId) && (isAdmin() || !isSignedIn());
    }

    // User Profile Mapping Accounts database
    match /users/{phone} {
      allow read: if true;
      allow create: if isValidUser(incoming()) && (isAdmin() || !isSignedIn() || isSignedIn());
      allow update: if isValidUser(incoming()) && (isAdmin() || !isSignedIn() || isSignedIn());
      allow delete: if isAdmin() || !isSignedIn();
    }
  }
}
